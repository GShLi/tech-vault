TECHVAULT_MINIO_URL=http://minio:9000
TECHVAULT_MINIO_ACCESS_KEY=minioadmin
TECHVAULT_MINIO_SECRET_KEY=minioadmin
TECHVAULT_MINIO_BUCKET=techvault
